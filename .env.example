# MEMOIR does not bundle a provider. Point it at any endpoint that speaks the
# OpenAI chat-completions wire protocol and give it a key and two model names.

# Required: the endpoint and key both roles use.
MEMOIR_LLM_BASE_URL=https://your-endpoint.example.com/v1
MEMOIR_LLM_API_KEY=

# Required: the model that answers questions, and the model that grades the
# open-ended tasks. The judge is usually the smaller and cheaper of the two.
MEMOIR_AGENT_MODEL=
MEMOIR_JUDGE_MODEL=

# Recommended: decoding held as fixed as your model family allows. What that
# means differs by family, so set it explicitly and report what you used
# alongside any number you publish.
# MEMOIR_AGENT_MODEL_KWARGS={"temperature": 0}
# MEMOIR_JUDGE_MODEL_KWARGS={"temperature": 0}

# Optional: run the two roles against different endpoints, for instance a large
# model on a hosted API and a small judge on a local server.
# MEMOIR_AGENT_BASE_URL=
# MEMOIR_AGENT_API_KEY=
# MEMOIR_JUDGE_BASE_URL=
# MEMOIR_JUDGE_API_KEY=

# Optional: read the corpus from somewhere other than ./data
# MEMOIR_DATA_DIR=/path/to/data
